PORT=3000
CORS_ORIGIN=http://localhost:3001   # production บังคับต้องตั้ง (คั่นหลายตัวด้วยจุลภาค)

# ── SQL Server (server เดียว ใช้ร่วมกันทุกฐาน) ──
DB_HOST=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true
# (ไม่บังคับ) DB_CONNECTION_TIMEOUT_MS=15000
# (ไม่บังคับ) DB_REQUEST_TIMEOUT_MS=30000

# ── ชื่อฐานข้อมูล (คนละฐาน server เดียวกัน) ──
DB_NAME=            # ฐานของ Smart Tracker
OPS_DB_NAME=        # ฐานของ OPS (อ่านรายชื่อบริษัท Supplier/Vendor)

# ── LINE ──
LINE_MINIAPP_CHANNEL_ID=

# ── Auth (JWT) ──
JWT_SECRET=                      # สุ่มยาว ๆ เช่น node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (ไม่บังคับ) JWT_ACCESS_TTL_SECONDS=900     # อายุ access token
# (ไม่บังคับ) JWT_REFRESH_TTL_DAYS=14        # อายุ refresh token (cookie)
# (ไม่บังคับ) AUTH_COOKIE_PATH=/api/auth     # path ของ cookie ตามที่เบราว์เซอร์เห็น (ผ่าน proxy ของ Next)
# (ไม่บังคับ) AUTH_COOKIE_SECURE=true        # cookie เฉพาะ https (ตั้ง false เฉพาะ dev http ล้วน)
# (ไม่บังคับ) TRUST_PROXY=1                   # จำนวน proxy ที่อยู่หน้า backend (Next=1, +tunnel/LB=2) ใช้หา IP จริงให้ rate limit

# ── ไฟล์แนบ/รูป ──
# (ไม่บังคับ) UPLOAD_DIR=./uploads              # ที่เก็บรูปที่อัปโหลดจาก Smart Tracker (ค่าเริ่มต้น ./uploads)
# (ไม่บังคับ) OPS_FILE_DIR=                    # โฟลเดอร์ไฟล์แนบของ OPS ที่ backend อ่านได้ (ชื่อไฟล์ตาม JobsDetails_Attatch.AttatchPath)
# (ไม่บังคับ) OPS_FILE_BASE_URL=               # หรือ URL ฐานของไฟล์ OPS เช่น http://10.x.x.x:10280/OPS_folder (ใช้ถ้าไม่ตั้ง OPS_FILE_DIR)
#                                              # backend ต้องเข้าถึง URL นี้ได้ (เครือข่ายภายใน) / ชื่อโฟลเดอร์ภาษาไทยให้เขียนแบบ %-encode
